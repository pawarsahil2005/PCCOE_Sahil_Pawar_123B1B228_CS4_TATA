# Active Default Engine: 100% On-Premise Local LLM (Zero Cloud Egress)
AI_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5-coder:1.5b

# Fallback: Google Gemini API (Only used if user explicitly selects Gemini fallback in UI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
